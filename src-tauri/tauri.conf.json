{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jaoo",
  "version": "0.1.0",
  "identifier": "br.com.jaoo.app",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jaoo",
        "width": 1280,
        "height": 800,
        "minWidth": 320,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": { "active": true, "targets": "all" }
}
